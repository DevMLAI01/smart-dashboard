# OpenRouter API (replaces Anthropic Claude for AI extraction)
# Get from: https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=sk-or-v1-...

# Upstash Redis (for dashboard links, usage tracking, and email collection)
# Get from: https://console.upstash.com → Create Database → REST API
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token-here

# Vercel Blob (optional — for storing original uploaded files)
# Get from: Vercel dashboard → Storage → Blob
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# Anthropic Claude API — no longer used (replaced by OpenRouter)
# ANTHROPIC_API_KEY=sk-ant-...
